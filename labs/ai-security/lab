#!/usr/bin/env bash
# The AI security lab (README.md). Both commands run their Python inside
# the dev api container, against the dev stack.
set -euo pipefail
cd "$(dirname "$0")/../.."

case "${1:-}" in
  redaction)
    exec docker compose exec -T api python - "${2:-both}" < labs/ai-security/redaction.py
    ;;
  setup)
    exec docker compose exec -T api python - setup < labs/ai-security/lab.py
    ;;
  *)
    echo 'usage: lab redaction [tuning|heldout|both] | lab setup' >&2
    exit 2
    ;;
esac
