#!/usr/bin/env bash
# The AI cost lab (README.md). `up` recreates the dev api on a real model
# (the local Ollama models, unless LLM_* and EMBEDDING_* are set in your
# shell, plus any VAR=value you give it); `down` puts it back on .env.
set -euo pipefail
cd "$(dirname "$0")/../.."

# The real models, from the shell or this repo's ollama profile. In the
# shell, never in .env: on a host running the production stack too, .env
# is shared.
export LLM_BASE_URL="${LLM_BASE_URL:-http://ollama:11434/v1}" LLM_API_KEY="${LLM_API_KEY:-ollama}"
export LLM_MODEL="${LLM_MODEL:-gpt-oss:20b}" LLM_REASONING_EFFORT="${LLM_REASONING_EFFORT-low}"
export EMBEDDING_MODEL="${EMBEDDING_MODEL:-nomic-embed-text}"
export EMBEDDING_QUERY_PREFIX="${EMBEDDING_QUERY_PREFIX-search_query: }"
export EMBEDDING_DOCUMENT_PREFIX="${EMBEDDING_DOCUMENT_PREFIX-search_document: }"
# The lab asks many questions in a row: the per-user chat limit would stop it.
export CHAT_RATE_LIMIT="${CHAT_RATE_LIMIT:-1000}"

recreate() {  # recreate [VAR=value]...: the dev api on the real model, plus these
  env "$@" docker compose up -d --wait api >/dev/null 2>&1
}
# Run from a copy inside the container, with the app on the path.
py() {
  docker compose cp labs/ai-cost/lab.py api:/tmp/cost_lab.py >/dev/null 2>&1
  docker compose exec -T -e PYTHONPATH=/api api python /tmp/cost_lab.py "$@"
}

case "${1:-}" in
  up)
    shift
    recreate "$@"
    echo "the dev api answers with $LLM_MODEL, embeddings $EMBEDDING_MODEL${*:+, and $*}"
    ;;
  seed | measure | tokens | cache | throughput)
    py "$@"
    ;;
  down)
    env -u LLM_BASE_URL -u LLM_API_KEY -u LLM_MODEL -u LLM_REASONING_EFFORT -u EMBEDDING_MODEL \
      -u EMBEDDING_QUERY_PREFIX -u EMBEDDING_DOCUMENT_PREFIX -u CHAT_RATE_LIMIT \
      docker compose up -d --wait api >/dev/null 2>&1
    echo "the dev api is back on .env's settings"
    ;;
  *)
    echo 'usage: lab up [VAR=value...] | lab down | lab seed | lab measure [n]' >&2
    echo '       lab tokens "<question>" | lab cache | lab throughput <concurrency> [seconds]' >&2
    exit 2
    ;;
esac
