          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "3600 * (sum(rate(llm_tokens_total{kind=\"prompt\"}[5m])) * $usd_per_1m_input + sum(rate(llm_tokens_total{kind=\"completion\"}[5m])) * $usd_per_1m_output) / 1e6",
