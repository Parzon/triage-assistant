{
  "realm": "triage",
  "displayName": "triage-assistant (local identity provider)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "permanentLockout": false,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 43200,
  "groups": [
    { "name": "org:admin" },
    { "name": "team:default:viewer" },
    { "name": "team:payments:viewer" },
    { "name": "team:payments:responder" },
    { "name": "team:payments:admin" },
    { "name": "team:platform:viewer" },
    { "name": "team:platform:responder" },
    { "name": "team:platform:admin" }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Payments",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }],
      "groups": ["/team:payments:responder", "/team:platform:viewer"]
    },
    {
      "username": "bob",
      "email": "bob@example.com",
      "firstName": "Bob",
      "lastName": "Platform",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }],
      "groups": ["/team:platform:admin", "/team:default:viewer"]
    },
    {
      "username": "carol",
      "email": "carol@example.com",
      "firstName": "Carol",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }],
      "groups": ["/org:admin"]
    },
    {
      "username": "dave",
      "email": "dave@example.com",
      "firstName": "Dave",
      "lastName": "Newcomer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }],
      "groups": []
    }
  ],
  "clients": [
    {
      "clientId": "triage-web",
      "name": "triage-assistant",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": ["${TRIAGE_PUBLIC_URL}/api/auth/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${TRIAGE_PUBLIC_URL}/"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false"
          }
        }
      ]
    }
  ]
}
