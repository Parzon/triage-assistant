# Copy to .env (`make setup` does it) and adjust. .env is gitignored; this
# file is the contract: every variable the stack reads is listed here.

# --- Postgres -----------------------------------------------------------------
# Schema owner: used by the postgres container and by migrations only.
POSTGRES_USER=triage_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=triage
# Runtime role the api connects as (through PgBouncer): rows only, no DDL.
# Created on first database start by infra/postgres/initdb/10-app-role.sh.
APP_DB_USER=triage_app
APP_DB_PASSWORD=change-me-app

# --- LLM ------------------------------------------------------------------------------
# Any OpenAI-compatible endpoint (OpenAI, Azure OpenAI, LiteLLM, vLLM, Ollama).
# Default: the local mock, started because of COMPOSE_PROFILES below.
LLM_BASE_URL=http://mock-llm:8020/v1
LLM_API_KEY=mock-key
LLM_MODEL=mock-1
# Reasoning models only (OpenAI o-series / gpt-5, gpt-oss): low | medium | high.
# Their thinking counts against the output limit. Empty: not sent.
LLM_REASONING_EFFORT=
# A real model on this machine: add "ollama" to COMPOSE_PROFILES, `make
# ollama-pull m=gpt-oss:20b`, then LLM_BASE_URL=http://ollama:11434/v1,
# LLM_API_KEY=ollama (any value), LLM_MODEL=gpt-oss:20b, LLM_REASONING_EFFORT=low.
# Evals only (development): the key of a judge at another provider than the
# model under test (make evals a="--judge --judge-base-url ..."). Empty: LLM_API_KEY.
JUDGE_API_KEY=
# Compose reads this from .env. "mock" starts tools/mock-llm: remove it when
# LLM_BASE_URL points at a real provider. "edge" starts the TLS edge in the
# production-shaped stack: remove it when a cloud load balancer terminates
# TLS in front of nginx (then publish nginx: HTTP_BIND=0.0.0.0, HTTP_PORT=80).
# "idp" starts the bundled identity provider (Keycloak): remove it when
# signing in with your organisation's provider (see Sign-in below).
COMPOSE_PROFILES=mock,edge,idp

# --- Sign-in (OIDC) ---------------------------------------------------------------------
# The identity provider is the bundled Keycloak by default (profile "idp" above;
# realm: infra/keycloak/triage-realm.json; demo users alice, bob, carol, dave).
# The production-shaped stack's address as browsers see it - with the port when
# it is not 443 (https://localhost:8443). The dev stack is always
# http://localhost:WEB_PORT and ignores this.
PUBLIC_URL=https://localhost
# The api's client secret at the provider (the bundled Keycloak reads it too).
OIDC_CLIENT_SECRET=change-me-oidc-client-secret
# Bundled Keycloak only: its administrator (console in dev:
# http://localhost:5173/auth/admin/) and the demo users' password. Set strong
# values before a demo is reachable from the internet.
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
DEMO_USER_PASSWORD=change-me-demo
# A real provider (Entra ID, Okta, Google Workspace, your own Keycloak):
# remove "idp" from COMPOSE_PROFILES, register <PUBLIC_URL>/api/auth/callback
# as the redirect URI (and <PUBLIC_URL>/ for sign-out) with the provider, and:
#   OIDC_ISSUER=https://login.example.com/...   exactly the provider's `iss`
#   OIDC_DISCOVERY_URL=                          empty: <issuer>/.well-known/...
#   OIDC_CLIENT_ID=<the provider's client id>
#   OIDC_GROUPS_CLAIM=groups                     "roles" for Entra ID app roles
# The claim must carry "team:<slug>:<role>" and "org:admin" values (handbook,
# security chapter).

# --- Observability (Prometheus, Alertmanager, Grafana, exporters) ---------------------
# Switch on by adding it to COMPOSE_PROFILES above (mock,observability) or
# with `make obs-up`. Ports bind to 127.0.0.1 (compose.override.yaml).
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
# Read-only statistics role for postgres-exporter (pg_monitor).
MONITOR_DB_USER=triage_monitor
MONITOR_DB_PASSWORD=change-me-monitor
# Shared by Alertmanager and the api's webhook endpoint. Empty = disabled.
ALERTMANAGER_WEBHOOK_TOKEN=change-me-long-random-string

# --- Dev ports (compose.override.yaml) --------------------------------------------
# 127.0.0.1 keeps the dev stack off the network. Set 0.0.0.0 only if you
# must reach it from another machine (published ports bypass ufw).
BIND_ADDR=127.0.0.1
API_PORT=8010
WEB_PORT=5173

# --- Production-shaped stack (compose.prod.yaml) ------------------------------------
# HTTPS: the edge (Caddy) is the only thing reachable from outside.
# SITE_ADDRESS: a domain whose DNS points at this host gets a Let's Encrypt
# certificate automatically; "localhost" gets one from Caddy's local CA.
SITE_ADDRESS=localhost
EDGE_BIND=0.0.0.0
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
# Browsers use HTTPS only for this many seconds once they have seen it.
# 0 for localhost; 31536000 for a real domain once HTTPS works.
HSTS_MAX_AGE=0
# nginx over plain HTTP, on this host's loopback only (drills, load tests).
HTTP_BIND=127.0.0.1
HTTP_PORT=8088
# gunicorn runs one worker per CPU in this limit.
API_CPUS=2
# Where images are pulled from / tagged as. Local builds: leave as is.
IMAGE_PREFIX=triage-assistant
IMAGE_TAG=local
