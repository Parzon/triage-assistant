{
  // "Reopen in Container" (VS Code, JetBrains, Codespaces) gives the editor
  // the container's Python and packages - completion, type checking, the
  // debugger, the same ruff/mypy/pytest as CI - on any laptop, with nothing
  // on the host but Docker. It attaches to the dev stack (`make up`).
  "name": "api (Python 3.13)",
  "dockerComposeFile": ["../../compose.yaml", "../../compose.override.yaml"],
  "service": "api",
  // The api's dependencies start with it; the mock LLM is listed because
  // the api deliberately does not depend on it.
  "runServices": ["api", "mock-llm"],
  "workspaceFolder": "/api",
  "shutdownAction": "none",
  // The dev image's own non-root user, created with your UID when make
  // builds it; on Linux, a mismatch (an image built outside make) is fixed
  // when the container is created.
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "ms-python.mypy-type-checker",
        "charliermarsh.ruff",
        "EditorConfig.EditorConfig"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/api/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true
        }
      }
    }
  }
}
