{
  // The web app in its container: Node 24 and node_modules from the
  // lockfile, whatever your laptop has installed. Attaches to `make up`.
  "name": "web (Node 24)",
  "dockerComposeFile": ["../../compose.yaml", "../../compose.override.yaml"],
  "service": "web",
  "workspaceFolder": "/app",
  "shutdownAction": "none",
  // The node image's own non-root user (UID 1000), renumbered to yours on Linux.
  "remoteUser": "node",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "oxc.oxc-vscode",
        "vitest.explorer",
        "EditorConfig.EditorConfig"
      ]
    }
  }
}
